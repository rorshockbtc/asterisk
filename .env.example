# Configuration for asterisk (*)
# Copy this file to .env.local (never commit .env.local).
# Local browser demo and Copy & Open publishing work out of the box with zero variables set.

# --- Site & Pipes Origin (canonical OpenGraph + two-way Pipes integration) ---
NEXT_PUBLIC_SITE_URL=https://asterisk.pipes.pink
# Use http://localhost:3002 when running local integration alongside pipes-unified
NEXT_PUBLIC_PIPES_URL=https://pipes.pink

# --- Clerk Authentication (optional on localhost; required for hosted Pipes auth) ---
# When unset, localhost uses dev-only stub sign-in at /api/auth/stub.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_IS_SATELLITE=true
NEXT_PUBLIC_CLERK_DOMAIN=asterisk.pipes.pink
NEXT_PUBLIC_CLERK_SIGN_IN_URL=https://pipes.pink/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=https://pipes.pink/sign-up
NEXT_PUBLIC_PIPES_AUTH_URL=https://pipes.pink

# --- Neon PostgreSQL (validates Clerk `profiles` & syncs `hash_entries` + Pipe media) ---
DATABASE_URL=
ASTERISK_REQUIRE_PROFILES_ROW=0

# --- Direct Channel Publishing Tokens (optional; Tier 1) ---
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
X_ACCESS_TOKEN=

# --- Local SQLite Fallback Storage ---
# Defaults to ./data/asterisk.db (gitignored)
ASTERISK_DB_PATH=./data/asterisk.db
